DATABASE_URL=postgres://ttv:ttv@localhost:5432/ttv?sslmode=disable
START_URL=https://tangthuvien.org/truyen?sort=rate&order=desc
CATALOG_MAX_PAGE=284

# One global scheduler shared by every worker. Default: 1 request per 3-4.5s.
# A Crawl-delay in robots.txt can raise this interval but never lowers it.
REQUEST_INTERVAL=3s
REQUEST_JITTER=1.5s
WORKERS=1

HTTP_TIMEOUT=30s
HTTP_RETRIES=3
MAX_RESPONSE_BYTES=8388608
USER_AGENT=TTVPersonalArchiver/1.0 (+personal offline reading; rate-limited)
BROWSER_EXECUTABLE=
ADMIN_ADDR=127.0.0.1:8080
PUBLIC_DIR=public
COVER_MAX_BYTES=5242880

# How long a parsed robots.txt is reused per host. Fetch failures are cached for
# a much shorter window and disallow the host until that entry expires.
ROBOTS_CACHE_TTL=12h

# The queue retries with exponential backoff; 0 means run until the queue drains.
MAX_JOB_ATTEMPTS=8
IDLE_EXIT_AFTER=0s
LOG_LEVEL=info
