DATABASE_URL=postgres://ttv:ttv@localhost:5432/ttv?sslmode=disable
START_URL=https://tangthuvien.org/truyen?sort=rate&order=desc
CATALOG_MAX_PAGE=284

# Một bộ lập lịch toàn cục áp dụng cho mọi worker. Mặc định: 1 request/3-4.5 giây.
REQUEST_INTERVAL=3s
REQUEST_JITTER=1.5s
WORKERS=1

HTTP_TIMEOUT=30s
HTTP_RETRIES=3
MAX_RESPONSE_BYTES=8388608
USER_AGENT=TTVPersonalArchiver/1.0 (+personal offline reading; rate-limited)
BROWSER_EXECUTABLE=
ADMIN_ADDR=127.0.0.1:8080

# Queue tự retry với exponential backoff; 0 nghĩa là chạy đến khi queue tạm rỗng.
MAX_JOB_ATTEMPTS=8
IDLE_EXIT_AFTER=0s
LOG_LEVEL=info
